# Defaults below match compose.yaml and are intentionally development-only.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ducklake
POSTGRES_USER=ducklake
POSTGRES_PASSWORD=ducklake

S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_REGION=us-east-1
S3_BUCKET=ducklake-poc

QUACK_HOST=0.0.0.0
QUACK_PORT=9494
QUACK_CLIENT_HOST=localhost
QUACK_TOKEN=duckdb-20-poc-token

DUCKDB_THREADS=6
DUCKDB_MEMORY_LIMIT=6GB
# Do not coalesce reads across unused Parquet column-byte gaps.
PARQUET_PREFETCH_COLUMN_GAP=0

# Large append-table profile: stop near 32 GB of DuckLake-managed Parquet.
APPEND_MAX_ROWS=2000000000
APPEND_TARGET_STORAGE_BYTES=32000000000
APPEND_WORKERS=10
APPEND_ROWS_PER_INSERT=5000000
APPEND_MAX_RETRIES=5
APPEND_ASSET_COUNT=50000
APPEND_MAX_STORAGE_BYTES=220000000000

# Energy benchmark defaults total 50 million fact rows.
ENERGY_LOAD_ROWS=20000000
ENERGY_GENERATION_ROWS=20000000
ENERGY_LMP_ROWS=10000000
ENERGY_LOAD_BATCH_ROWS=5000000
ENERGY_RESET=false

BENCHMARK_CONCURRENCY=1
BENCHMARK_REPETITIONS=3
BENCHMARK_WARMUPS=1
